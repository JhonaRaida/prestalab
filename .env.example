# Copia este archivo a ".env" (cp .env.example .env) y cambia los secretos. NO subas .env al repositorio.

# --- Seguridad ---
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria
SERVICE_TOKEN=cambia-este-token-interno-entre-servicios
# Duración del token de acceso en segundos (opcional, por defecto 3600 = 1 hora)
# JWT_EXPIRA_SEGUNDOS=3600
# En producción (NODE_ENV=production, como en Docker) el sistema NO arranca si estos dos valores siguen
# siendo los de ejemplo o tienen menos de 16 caracteres. Genera uno bueno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- CORS ---
# Orígenes (separados por coma) que pueden llamar a la API desde un navegador. Vacío = ninguno
# (el proyecto es solo backend). Ejemplo: CORS_ORIGINS=http://localhost:5173,https://prestalab.ejemplo.mx
# CORS_ORIGINS=

# --- Base de datos (una instancia de PostgreSQL, una base por servicio) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=prestalab
DB_PASSWORD=prestalab

# --- Puertos (solo el del Gateway se publica al exterior en Docker) ---
PORT_GATEWAY=8080
PORT_USUARIOS=3001
PORT_INVENTARIO=3002
PORT_RESERVAS=3003
PORT_NOTIFICACIONES=3004
PORT_REPORTES=3005

# --- Reglas de negocio (opcional, estos son los valores por defecto) ---
# TOLERANCIA_MINUTOS=15
# SANCION_DIAS=3
# CANCELAR_MINUTOS_ANTES=60
# LIMITE_SESIONES_MIN=20
# LIMITE_GENERAL_MIN=600

# --- Datos de prueba ---
# Se cargan solo si las tablas están vacías. Ponlo en "off" para un despliegue sin datos de demostración.
# DATOS_PRUEBA=on
