# Copia este archivo a ".env" (cp .env.example .env) y cambia los secretos. NO subas .env al repositorio.

# --- Seguridad ---
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria
SERVICE_TOKEN=cambia-este-token-interno-entre-servicios

# --- Base de datos (una instancia de PostgreSQL, una base por servicio) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=prestalab
DB_PASSWORD=prestalab

# --- Puertos (solo el del Gateway se publica al exterior en Docker) ---
PORT_GATEWAY=8080
PORT_USUARIOS=3001
PORT_INVENTARIO=3002
PORT_RESERVAS=3003
PORT_NOTIFICACIONES=3004
PORT_REPORTES=3005

# --- Reglas de negocio (opcional, estos son los valores por defecto) ---
# TOLERANCIA_MINUTOS=15
# SANCION_DIAS=3
# CANCELAR_MINUTOS_ANTES=60
# LIMITE_SESIONES_MIN=20
# LIMITE_GENERAL_MIN=600

# --- Datos de prueba ---
# Se cargan solo si las tablas están vacías. Ponlo en "off" para un despliegue sin datos de demostración.
# DATOS_PRUEBA=on
