digraph ER {
 graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.2, ranksep=0.35, pad=0.2, compound=true];
 node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
 edge [fontname="DejaVu Sans", fontsize=8];
 subgraph cluster_usuarios { label=<<B>Usuarios y Autenticación · usuarios_db</B>>; labeljust=l; fontsize=12; style="rounded,filled"; fillcolor="#E3EEFA33"; color="#3F72AF"; penwidth=1.6;
 roles [label=<<TABLE BORDER="1" COLOR="#3F72AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#3F72AF"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="codigo"><B>codigo</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">VARCHAR(15)</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR></TABLE>>];
 sanciones [label=<<TABLE BORDER="1" COLOR="#3F72AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#3F72AF"><FONT COLOR="white"><B>sanciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="prestamo_id">prestamo_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD></TD></TR></TABLE>>];
 usuarios [label=<<TABLE BORDER="1" COLOR="#3F72AF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#3F72AF"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT" PORT="correo">correo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">VARCHAR(160)</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E3EEFA"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" PORT="rol">rol</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">VARCHAR(15)</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR></TABLE>>];
 }
 subgraph cluster_inventario { label=<<B>Inventario · inventario_db</B>>; labeljust=l; fontsize=12; style="rounded,filled"; fillcolor="#E2F2E233"; color="#3F8F4F"; penwidth=1.6;
 categorias [label=<<TABLE BORDER="1" COLOR="#3F8F4F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#3F8F4F"><FONT COLOR="white"><B>categorias</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">VARCHAR(80)</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR></TABLE>>];
 laboratorios [label=<<TABLE BORDER="1" COLOR="#3F8F4F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#3F8F4F"><FONT COLOR="white"><B>laboratorios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">VARCHAR(120)</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="encargado_id">encargado_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD></TD></TR></TABLE>>];
 recursos [label=<<TABLE BORDER="1" COLOR="#3F8F4F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#3F8F4F"><FONT COLOR="white"><B>recursos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT" PORT="codigo_inventario">codigo_inventario</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">VARCHAR(40)</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" PORT="categoria_id">categoria_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E2F2E2"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" PORT="laboratorio_id">laboratorio_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR></TABLE>>];
 }
 subgraph cluster_reservas { label=<<B>Reservas y Préstamos · reservas_db</B>>; labeljust=l; fontsize=12; style="rounded,filled"; fillcolor="#FCE9D633"; color="#D1792B"; penwidth=1.6;
 incidencias [label=<<TABLE BORDER="1" COLOR="#D1792B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#D1792B"><FONT COLOR="white"><B>incidencias</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" PORT="prestamo_id">prestamo_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="recurso_id">recurso_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR></TABLE>>];
 prestamos [label=<<TABLE BORDER="1" COLOR="#D1792B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#D1792B"><FONT COLOR="white"><B>prestamos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK UQ</FONT></TD><TD ALIGN="LEFT" PORT="reserva_id">reserva_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="entregado_por">entregado_por</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="recibido_por">recibido_por</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD></TD></TR></TABLE>>];
 reservas [label=<<TABLE BORDER="1" COLOR="#D1792B" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#D1792B"><FONT COLOR="white"><B>reservas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="recurso_id">recurso_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="laboratorio_id">laboratorio_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FCE9D6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="encargado_id">encargado_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD></TD></TR></TABLE>>];
 }
 subgraph cluster_notificaciones { label=<<B>Notificaciones · notificaciones_db</B>>; labeljust=l; fontsize=12; style="rounded,filled"; fillcolor="#EDE3F633"; color="#7E57B0"; penwidth=1.6;
 notificaciones [label=<<TABLE BORDER="1" COLOR="#7E57B0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="4" BGCOLOR="#7E57B0"><FONT COLOR="white"><B>notificaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE3F6"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">SERIAL</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EDE3F6"><FONT POINT-SIZE="8">FK*</FONT></TD><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#444444">INTEGER</FONT></TD><TD> <FONT COLOR="#555555">●</FONT></TD></TR></TABLE>>];
 }
 sanciones:usuario_id:e -> usuarios:id:w [dir=both, arrowtail=crow, arrowhead=tee, color="#333333", penwidth=1.5];
 usuarios:rol:e -> roles:codigo:w [dir=both, arrowtail=crow, arrowhead=tee, color="#333333", penwidth=1.5];
 recursos:categoria_id:e -> categorias:id:w [dir=both, arrowtail=crow, arrowhead=tee, color="#333333", penwidth=1.5];
 recursos:laboratorio_id:e -> laboratorios:id:w [dir=both, arrowtail=crow, arrowhead=tee, color="#333333", penwidth=1.5];
 incidencias:prestamo_id:e -> prestamos:id:w [dir=both, arrowtail=crow, arrowhead=tee, color="#333333", penwidth=1.5];
 prestamos:reserva_id:e -> reservas:id:w [dir=both, arrowtail=crow, arrowhead=tee, color="#333333", penwidth=1.5];
 reservas -> usuarios [ltail=cluster_reservas, lhead=cluster_usuarios, dir=both, arrowtail=crow, arrowhead=tee, style=dashed, color="#C0392B", fontcolor="#C0392B", penwidth=1.6, fontsize=9, label="reservas.usuario_id\nreservas.encargado_id\nprestamos.entregado_por\nprestamos.recibido_por", constraint=true];
 reservas -> recursos [ltail=cluster_reservas, lhead=cluster_inventario, dir=both, arrowtail=crow, arrowhead=tee, style=dashed, color="#C0392B", fontcolor="#C0392B", penwidth=1.6, fontsize=9, label="reservas.recurso_id\nreservas.laboratorio_id\nincidencias.recurso_id", constraint=true];
 laboratorios -> usuarios [ltail=cluster_inventario, lhead=cluster_usuarios, dir=both, arrowtail=crow, arrowhead=tee, style=dashed, color="#C0392B", fontcolor="#C0392B", penwidth=1.6, fontsize=9, label="laboratorios.encargado_id", constraint=true];
 notificaciones -> usuarios [ltail=cluster_notificaciones, lhead=cluster_usuarios, dir=both, arrowtail=crow, arrowhead=tee, style=dashed, color="#C0392B", fontcolor="#C0392B", penwidth=1.6, fontsize=9, label="notificaciones.usuario_id", constraint=true];
 sanciones -> prestamos [ltail=cluster_usuarios, lhead=cluster_reservas, dir=both, arrowtail=crow, arrowhead=tee, style=dashed, color="#C0392B", fontcolor="#C0392B", penwidth=1.6, fontsize=9, label="sanciones.prestamo_id", constraint=true];
}